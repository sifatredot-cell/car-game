<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Simple Car Game — Bangladesh Edition 🚗</title>
<style>
  :root{
    --bg:#111827;
    --road:#333;
    --lane:#9ca3af;
    --car:#ef4444;
    --ob:#111827;
    --ui:#f3f4f6;
  }
  html,body{
    height:100%;
    margin:0;
    font-family:Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    background: linear-gradient(180deg,#0b1220, #0f1724);
    color:var(--ui);
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .wrap{
    width:360px;
    max-width:92vw;
    background: linear-gradient(180deg,#0f1724,#071422);
    border-radius:12px;
    padding:12px;
    box-shadow: 0 8px 30px rgba(2,6,23,0.7);
  }
  header{ display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:8px;}
  header h1{font-size:16px; margin:0;}
  header .info{font-size:12px; opacity:0.9;}
  canvas{
    display:block;
    width:100%;
    height:520px;
    background: linear-gradient(#2b2b2b, #1f2937);
    border-radius:8px;
    image-rendering: pixelated;
  }
  .controls{
    margin-top:8px;
    display:flex;
    gap:6px;
    align-items:center;
    justify-content:space-between;
  }
  .btn{
    background:transparent;
    border:1px solid rgba(255,255,255,0.08);
    color:var(--ui);
    padding:8px 10px;
    border-radius:8px;
    cursor:pointer;
    font-size:13px;
  }
  .touch{
    display:flex;
    gap:8px;
  }
  .touch .tbtn{
    width:56px; height:46px;
    border-radius:8px;
    background:rgba(255,255,255,0.04);
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:18px;
    user-select:none;
  }
  .status{ font-size:13px; opacity:0.95; }
  footer{ font-size:11px; margin-top:8px; opacity:0.8; text-align:center;}
</style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>Simple Car Game</h1>
      <div class="info">Score: <span id="ui-score">0</span></div>
    </header>

    <canvas id="game"></canvas>

    <div class="controls">
      <div>
        <button id="startBtn" class="btn">Start</button>
        <button id="pauseBtn" class="btn">Pause</button>
        <button id="resetBtn" class="btn">Reset</button>
      </div>

      <div class="status">
        Speed: <span id="ui-speed">1.0</span>x
      </div>
    </div>

    <div style="display:flex;justify-content:center;margin-top:8px;">
      <div class="touch" id="touchControls">
        <div class="tbtn" id="leftBtn">◀</div>
        <div class="tbtn" id="accBtn">▲</div>
        <div class="tbtn" id="rightBtn">▶</div>
      </div>
    </div>

    <footer>Controls: ← → or A / D — Touch buttons supported — Space to restart after crash</footer>
  </div>

<script>
/* Full JavaScript code of car game — works on mobile + PC */

const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d', { alpha: false });

function resizeCanvas(){ canvas.width = 360; canvas.height = 520; }
resizeCanvas();

const uiScore = document.getElementById('ui-score');
const uiSpeed = document.getElementById('ui-speed');
const startBtn = document.getElementById('startBtn');
const pauseBtn = document.getElementById('pauseBtn');
const resetBtn = document.getElementById('resetBtn');

let running = false;
let paused = false;
let lastTime = 0;
let deltaAcc = 0;
let score = 0;
let speedMultiplier = 1.0;
let crash = false;

const road = { x: 40, width: canvas.width - 80, laneCount: 3, lineWidth: 4 };

const car = {
  w: 34, h: 50,
  x: canvas.width/2 - 17,
  y: canvas.height - 90,
  speed: 220,
  color: '#ef4444',
  lane: 1
};

let obstacles = [];
const obstacleConfig = {
  spawnInterval: 1200, lastSpawn: 0,
  minW: 36, maxW: 84,
  minH: 20, maxH: 36
};

function laneCenter(l){
  const laneWidth = road.width / road.laneCount;
  return road.x + laneWidth*l + laneWidth/2;
}

function resetGame(){
  obstacles = [];
  score = 0;
  speedMultiplier = 1.0;
  crash = false;
  car.lane = 1;
  car.x = laneCenter(car.lane) - car.w/2;
  obstacleConfig.lastSpawn = performance.now();
  uiScore.textContent = '0';
  uiSpeed.textContent = speedMultiplier.toFixed(2);
}

function spawnObstacle(now){
  const lane = Math.floor(Math.random() * road.laneCount);
  const w = Math.random()*(obstacleConfig.maxW - obstacleConfig.minW) + obstacleConfig.minW;
  const h = Math.random()*(obstacleConfig.maxH - obstacleConfig.minH) + obstacleConfig.minH;
  const x = laneCenter(lane) - w/2;
  obstacles.push({ x, y: -h - 10, w, h, lane, speed: 120 + Math.random()*120 });
  obstacleConfig.lastSpawn = now;
}

function rectsIntersect(a, b){
  return !(a.x + a.w < b.x || a.x > b.x + b.w || a.y + a.h < b.y || a.y > b.y + b.h);
}

const keys = {};
window.addEventListener('keydown', e =>{ keys[e.key.toLowerCase()] = true;
  if(e.code === 'Space' && crash){ resetGame(); running = true; paused = false; lastTime = performance.now(); requestAnimationFrame(loop);}
});
window.addEventListener('keyup', e =>{ keys[e.key.toLowerCase()] = false; });

function update(dt){
  if(paused || crash) return;

  deltaAcc += dt;
  if(deltaAcc > 5){ deltaAcc = 0; speedMultiplier += 0.06; }
  uiSpeed.textContent = speedMultiplier.toFixed(2);

  if(keys['arrowleft'] && car.lane > 0){ car.lane--; keys['arrowleft']=false; }
  if(keys['a'] && car.lane > 0){ car.lane--; keys['a']=false; }
  if(keys['arrowright'] && car.lane < 2){ car.lane++; keys['arrowright']=false; }
  if(keys['d'] && car.lane < 2){ car.lane++; keys['d']=false; }

  const targetX = laneCenter(car.lane) - car.w/2;
  car.x += (targetX - car.x) * Math.min(1, dt * 8);

  const accel = keys['arrowup'] || keys['w'];
  const speedB = accel ? 1.6 : 1.0;

  const now = performance.now();
  if(now - obstacleConfig.lastSpawn > obstacleConfig.spawnInterval / Math.max(1,speedMultiplier)){
    spawnObstacle(now);
  }

  for(let i=obstacles.length-1;i>=0;i--){
    let o = obstacles[i];
    o.y += (o.speed * speedB + 50*speedMultiplier) * dt;
    if(o.y > canvas.height + 200) obstacles.splice(i,1);
  }

  score += dt * 10 * speedMultiplier;
  uiScore.textContent = Math.floor(score);

  const playerRect = { x: car.x, y: car.y, w: car.w, h: car.h };
  for(const o of obstacles){
    if(rectsIntersect(playerRect, o)){ crash = true; running = false; break; }
  }
}

function draw(){
  ctx.fillStyle = '#0b1220'; ctx.fillRect(0,0,canvas.width,canvas.height);

  ctx.fillStyle = '#2b2b2b';
  ctx.fillRect(road.x,0,road.width,canvas.height);

  ctx.strokeStyle = '#9ca3af'; ctx.setLineDash([18,14]); ctx.lineWidth = 4;
  const laneW = road.width / road.laneCount;
  for(let i=1;i<road.laneCount;i++){
    const lx = road.x + i*laneW;
    ctx.beginPath(); ctx.moveTo(lx,0); ctx.lineTo(lx,canvas.height); ctx.stroke();
  }
  ctx.setLineDash([]);

  for(const o of obstacles){
    ctx.fillStyle = '#111827';
    ctx.fillRect(o.x,o.y,o.w,o.h);
  }

  ctx.fillStyle = car.color;
  ctx.fillRect(car.x,car.y,car.w,car.h);

  if(crash){
    ctx.fillStyle='rgba(0,0,0,0.6)'; ctx.fillRect(0,0,360,520);
    ctx.fillStyle='#ff6666'; ctx.font='22px Arial'; ctx.textAlign='center';
    ctx.fillText('You Crashed!',180,250);
    ctx.font='12px Arial'; ctx.fillStyle='#fff';
    ctx.fillText('Press SPACE to restart',180,280);
  }
}

function loop(ts){
  if(!running){ draw(); return; }
  const now = ts || performance.now();
  const dt = Math.min(0.05,(now-lastTime)/1000);
  lastTime = now;

  update(dt);
  draw();

  if(!crash) requestAnimationFrame(loop);
}

startBtn.addEventListener('click', ()=>{ if(!running){ running=true; paused=false; lastTime=performance.now(); requestAnimationFrame(loop);} });
pauseBtn.addEventListener('click', ()=>{ paused=!paused; if(paused){ running=false; pauseBtn.textContent='Resume'; } else { running=true; pauseBtn.textContent='Pause'; lastTime=performance.now(); requestAnimationFrame(loop);} });
resetBtn.addEventListener('click', ()=>{ resetGame(); draw(); });

resetGame();
draw();
</script>
</body>
</html>
